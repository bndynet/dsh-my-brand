{
  "name": "@bndynet/dsh-my-brand",
  "version": "0.2.0",
  "description": "Harness branding for the DSH Web client: logo mark, wordmark, home headline and browser icon.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndynet/dsh-my-brand.git"
  },
  "homepage": "https://github.com/bndynet/dsh-my-brand#readme",
  "bugs": {
    "url": "https://github.com/bndynet/dsh-my-brand/issues"
  },
  "author": "Bendy Zhang <zb@bndy.net>",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "brand",
    "logo"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "prepack": "npm test"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
